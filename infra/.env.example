# Copy to .env and pick a scenario — repo files stay untouched.
#   Scenario 1 (all local):        docker compose --profile edge up -d
#   Scenario 2 (external Keycloak): docker compose --profile edge-external up -d
#   Platform only (no edge):       docker compose up -d

# --- scenario 2: external Keycloak ---
# Caddy upstream for auth.* hosts (scenario 1 keeps the default local service)
KC_UPSTREAM=keycloak:8080
# Controller OIDC: empty + PUSHIT_DEV=1 → dev mode (no auth checks)
PUSHIT_DEV=1
PUSHIT_OIDC_ISSUER=
PUSHIT_OIDC_CLIENT_SECRET=

# --- local keycloak (scenario 1) ---
KC_ADMIN_PASSWORD=changeme-local

# --- common ---
PUSHIT_BASE_DOMAIN=localhost
# random hex for anything real: openssl rand -hex 32
PUSHIT_SESSION_KEY=
