{
	# Internal CA for *.apps.internal.lan; disable for plain-HTTP dev
	local_certs
}

# Keycloak — upstream comes from KC_UPSTREAM env (compose injects it;
# default is the local `keycloak` service, set it to your external KC URL
# for the edge-external scenario)
auth.apps.internal.lan {
	reverse_proxy {$KC_UPSTREAM}
}

# All app traffic (incl. hub.apps.internal.lan) → controller.
# Controller routes by Host; forward-auth is enforced by checking
# the session via Keycloak — simplest working variant: oauth2-proxy
# or Caddy forward_auth to an auth endpoint. MVP: controller validates
# JWT/session itself for API; app GET requests carry the hub session cookie.
*.apps.internal.lan {
	reverse_proxy controller:9100
}
